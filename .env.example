VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# scripts/operations/google-index.mjs (manual indexing operator script) reads
# this as a real OS environment variable, not from this .env file (the script
# is invoked directly with `node`, no dotenv loading). Set it in your shell
# when you want to point at a credential file outside the repo:
#   GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# See docs/google-indexing-operations.md for details.
