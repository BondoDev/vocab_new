{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fluentstellar.com"
        }
      ],
      "destination": "https://www.fluentstellar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fluentstellar.vercel.app"
        }
      ],
      "destination": "https://www.fluentstellar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:uiLang(en|es|fr|de|it|pt|ru)/:target(english|spanish|french|german|italian|portuguese|russian)-word-:wordSlug([^/]+)-:cefr(A1|A2|B1|B2|C1|C2)-:wordId([0-9]{5})",
      "destination": "/:uiLang/:target-word-:wordSlug--:cefr-:wordId",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemaps/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/word-ssr-internal.ts": {
      "includeFiles": [
        "dist/index.html",
        "server-build/entry-server.js",
        "src/data/vocabulary/**/*.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/word-ssr-internal",
      "destination": "/api/word-ssr"
    },
    {
      "source": "/:uiLang([a-z]{2})/:wordRoute([^/]*-word-[^/]+)",
      "destination": "/api/word-ssr-internal?pathname=/:uiLang/:wordRoute"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/languages/filters/exercises/practice",
      "destination": "/index.html"
    }
  ]
}
