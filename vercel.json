{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fluentstellar.com"
        }
      ],
      "destination": "https://www.fluentstellar.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fluentstellar.vercel.app"
        }
      ],
      "destination": "https://www.fluentstellar.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemaps/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/word-ssr-internal.ts": {
      "includeFiles": "{dist/index.html,server-build/entry-server.js,src/data/vocabulary/**/*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/:uiLanguage/:slug",
      "destination": "/api/word-ssr-internal?pathname=/:uiLanguage/:slug"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/languages/filters/exercises/practice",
      "destination": "/index.html"
    }
  ]
}
