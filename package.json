{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate:word-hub-data": "node scripts/generate-word-hub-data.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "sync:vocabulary-levels": "node scripts/sync-vocabulary-levels.mjs",
    "check:vocabulary-levels-sync": "node scripts/sync-vocabulary-levels.mjs --check",
    "prebuild": "npm run -s check:vocabulary-levels-sync && npm run -s generate:word-hub-data && npm run -s sitemap",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir server-build && node scripts/cleanup-word-build-artifacts.mjs && node scripts/prerender.mjs && node ./scripts/verify-word-ssr-package.mjs",
    "dev": "vite",
    "test:word-route-manifest": "node scripts/test-word-route-manifest.mjs",
    "test:word-hydration": "node scripts/test-word-hydration.mjs",
    "test:word-seo": "node scripts/test-word-seo-routes.mjs",
    "test:level-browse-preview": "node scripts/test-level-browse-preview-completeness.mjs",
    "test:word-ssr-http": "node scripts/test-word-ssr-http.mjs",
    "test:word-ssr-package": "node ./scripts/verify-word-ssr-package.mjs",
    "test:homepage-visibility": "node scripts/test-homepage-visibility.mjs",
    "test:jsonld-escaping": "node scripts/test-jsonld-escaping.mjs",
    "test:schema-graph": "node scripts/test-schema-graph.mjs",
    "test:word-browse-pagination": "node scripts/test-word-browse-pagination.mjs",
    "test:prerender-parity": "node scripts/test-prerender-parity.mjs",
    "test:sitemap-structure": "node scripts/test-sitemap-structure.mjs",
    "test:sitemap-lastmod": "node scripts/test-sitemap-lastmod-stability.mjs",
    "test:seo-core-routes": "node scripts/test-seo-core-routes.mjs",
    "test:seo-output": "npm run -s test:word-ssr-http && npm run -s test:word-ssr-package && npm run -s test:homepage-visibility && npm run -s test:jsonld-escaping && npm run -s test:schema-graph && npm run -s test:word-browse-pagination && npm run -s test:prerender-parity && npm run -s test:sitemap-structure && npm run -s test:sitemap-lastmod && npm run -s test:seo-core-routes",
    "test:seo-baseline": "npm run -s test:seo-output",
    "test:architecture-guards": "npm run -s test:word-seo && npm run -s test:level-browse-preview && npm run -s test:import-boundaries && npm run -s test:generated-data-ownership && npm run -s test:interactive-contracts && npm run -s test:ui-component-ownership && npm run -s test:dependency-ownership && npm run -s test:legacy-poc-ownership && npm run -s test:guidelines-ownership",
    "test:word-worker:runtime": "node scripts/test-word-worker-runtime.mjs",
    "test:word-worker:bundle-size": "node scripts/test-word-worker-bundle-size.mjs",
    "test:crawler-policy": "node scripts/test-crawler-policy.mjs",
    "test:import-boundaries": "node scripts/test-import-boundaries.mjs",
    "test:generated-data-ownership": "node scripts/test-generated-data-ownership.mjs",
    "test:interactive-contracts": "node scripts/test-interactive-contracts.mjs",
    "test:ui-component-ownership": "node scripts/test-ui-component-ownership.mjs",
    "test:dependency-ownership": "node scripts/test-dependency-ownership.mjs",
    "test:legacy-poc-ownership": "node scripts/test-legacy-poc-ownership.mjs",
    "test:guidelines-ownership": "node scripts/test-guidelines-ownership.mjs",
    "test:word-worker:production-safety": "npm run -s test:word-worker:runtime && npm run -s test:word-worker:bundle-size && npm run -s test:crawler-policy",
    "build:word-worker:full": "node scripts/build-word-worker-full.mjs",
    "seo-baseline:capture": "node scripts/seo-baseline/capture.mjs",
    "seo-baseline:compare": "node scripts/seo-baseline/compare.mjs",
    "benchmark:word-render": "node scripts/benchmark-word-render.mjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-label": "2.1.2",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "fast-xml-parser": "^5.9.3",
    "flag-icons": "7.2.1",
    "googleapis": "^173.0.0",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "react": "18.3.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "18.3.1",
    "react-responsive-masonry": "2.7.1",
    "react-router-dom": "6.26.2",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.7.0",
    "sass": "^1.84.0",
    "tailwindcss": "4.1.12",
    "typescript": "5.6.3",
    "vite": "6.3.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}
